<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd" id="WebApp_ID" version="3.0">
  <display-name>EduHappy</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.jsp</welcome-file>
  </welcome-file-list>
  <context-param>
    <param-name>UploadedFilesPath</param-name>
    <param-value>C:\\Users\\Hossam\\Desktop\\Development\\webapps\\.metadata\\.plugins\\org.eclipse.wst.server.core\\tmp0\\wtpwebapps\\EduHappy\\</param-value>
  </context-param>
  <filter>
    <filter-name>AccountPagesFilter</filter-name>
    <filter-class>
        filters.account.AccountSecurity
    </filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AccountPagesFilter</filter-name>
    <url-pattern>/Account/*</url-pattern>
    <dispatcher>FORWARD</dispatcher>
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>
  <filter>
    <filter-name>AdminPagesFilter</filter-name>
    <filter-class>
        filters.admin.AdminSecurity
    </filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AdminPagesFilter</filter-name>
    <url-pattern>/Admin/*</url-pattern>
  </filter-mapping>
  <filter>
    <filter-name>TeacherPagesFilter</filter-name>
    <filter-class>
        filters.teacher.TeacherSecurity
    </filter-class>
  </filter>
  <filter-mapping>
    <filter-name>TeacherPagesFilter</filter-name>
    <url-pattern>/Teacher/*</url-pattern>
  </filter-mapping>
  <filter>
    <filter-name>StudentPagesFilter</filter-name>
    <filter-class>
        filters.student.StudentSecurity
    </filter-class>
  </filter>
  <filter-mapping>
    <filter-name>StudentPagesFilter</filter-name>
    <url-pattern>/Student/*</url-pattern>
  </filter-mapping>
  <filter>
    <filter-name>ParentPagesFilter</filter-name>
    <filter-class>
        filters.parent.ParentSecurity
    </filter-class>
  </filter>
  <filter-mapping>
    <filter-name>ParentPagesFilter</filter-name>
    <url-pattern>/Parent/*</url-pattern>
  </filter-mapping>
  <filter>
    <filter-name>IllegalOperation</filter-name>
    <filter-class>
        filters.IllegalOperation
    </filter-class>
  </filter>
  <filter-mapping>
    <filter-name>IllegalOperation</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>FORWARD</dispatcher>
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>
  <listener>
    <listener-class>listeners.ContextFinalizer</listener-class>
  </listener>
  <session-config>
    <session-timeout>4800</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>
</web-app>